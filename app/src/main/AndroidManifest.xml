<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- [Beta] KB 무로그인 빠른조회 및 Pro 티어 동기화를 위한 네트워크 권한 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 선택적 SMS 문자 파싱 권한 (카메라/전화가 없는 태블릿 호환성 보장) -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <application
        android:name=".HouseholdBookApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.HouseholdBook">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.HouseholdBook"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 금융 앱(KB, 토스 등) 푸시 알림 자동 감지 서비스 -->
        <service
            android:name=".data.ingestion.notification.FinancialNotificationListenerService"
            android:exported="true"
            android:label="가계부 금융 알림 자동 수집기"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- 집밥 절약 홈 화면 위젯 (원터치 +1 기록) -->
        <receiver
            android:name=".ui.widget.MealSaverWidgetProvider"
            android:exported="false"
            android:label="@string/widget_meal_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/meal_saver_widget_info" />
        </receiver>

        <!-- 금융 문자(SMS) 자동 감지 리시버 -->
        <receiver
            android:name=".data.ingestion.sms.SmsBroadcastReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
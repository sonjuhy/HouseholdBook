<?xml version="1.0" encoding="utf-8"?>
<!--
  테마 아이콘(Android 13+ '테마 아이콘' 설정)용 단색 레이어
  - 전경 이미지와 같은 위치·크기의 장부 윤곽 + 왼쪽 제본선 + 체크 표시
    (한 가지 색이라 공용·개인 색 구분은 표현할 수 없어, 장부로 읽히는 모양을 우선)
  - 색은 시스템이 배경화면에 맞춰 칠하므로 모양(알파)만 의미 있음
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- 장부 윤곽 -->
    <path
        android:pathData="M38,29.5 L70,29.5 A7,7 0,0 1,77 36.5 L77,72.5 A7,7 0,0 1,70 79.5 L38,79.5 A7,7 0,0 1,31 72.5 L31,36.5 A7,7 0,0 1,38 29.5 Z"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3.5"
        android:fillColor="#00000000" />
    <!-- 왼쪽 제본선 -->
    <path
        android:pathData="M38.5,31 L38.5,78"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2.5"
        android:strokeLineCap="round" />
    <!-- 체크 표시 -->
    <path
        android:pathData="M50.5,55 L55.5,60 L64,51.5"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
</vector>

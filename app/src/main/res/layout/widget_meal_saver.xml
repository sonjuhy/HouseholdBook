<?xml version="1.0" encoding="utf-8"?>
<!-- 집밥 절약 홈 화면 위젯: 이번 정산 주기 절약 금액 + 끼니별 원터치 +1 버튼 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/widget_space_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/widget_meal_title"
        android:textColor="@color/widget_text_secondary"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/widget_saved_amount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/widget_meal_loading"
        android:textColor="@color/widget_accent"
        android:textSize="19sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_meal_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/widget_text_primary"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:minHeight="40dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_btn_breakfast"
            style="@style/HouseholdWidgetMealButton"
            android:text="@string/widget_meal_breakfast" />

        <TextView
            android:id="@+id/widget_btn_lunch"
            style="@style/HouseholdWidgetMealButton"
            android:layout_marginStart="6dp"
            android:text="@string/widget_meal_lunch" />

        <TextView
            android:id="@+id/widget_btn_dinner"
            style="@style/HouseholdWidgetMealButton"
            android:layout_marginStart="6dp"
            android:text="@string/widget_meal_dinner" />

        <TextView
            android:id="@+id/widget_btn_snack"
            style="@style/HouseholdWidgetMealButton"
            android:layout_marginStart="6dp"
            android:text="@string/widget_meal_snack" />
    </LinearLayout>
</LinearLayout>

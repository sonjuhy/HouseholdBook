# 출시 서명 설정 예시 — 이 파일을 keystore.properties로 복사한 뒤 실제 값으로 바꾸세요.
# keystore.properties와 .jks 파일은 .gitignore에 포함되어 저장소에 올라가지 않습니다.
#
# 키 만들기 예:
#   keytool -genkeypair -v -keystore householdbook-release.jks -keyalg RSA -keysize 4096 -validity 10000 -alias householdbook
storeFile=householdbook-release.jks
storePassword=CHANGE_ME
keyAlias=householdbook
keyPassword=CHANGE_ME
